{
  "name": "@stanza/cli",
  "version": "0.1.0",
  "description": "Modular monorepo template CLI — shadcn for stacks.",
  "license": "MIT",
  "bin": {
    "stanza": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "kleur": "^4.1.5",
    "mri": "^1.2.0",
    "semver": "^7.8.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stanza/codemods": "workspace:*",
    "@stanza/registry": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}

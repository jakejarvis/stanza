{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [{{#if (eq peers.framework "next")}}".next/**", "!.next/cache/**"{{else if (eq peers.framework "tanstack-start")}}".output/**", "dist/**"{{else}}"dist/**"{{/if}}]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
